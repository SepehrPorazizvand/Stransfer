<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StransferSetup</AssemblyName>
    <RootNamespace>Stransfer.Installer</RootNamespace>
    <ApplicationIcon Condition="Exists('../Stransfer.App/Assets/app.ico')">../Stransfer.App/Assets/app.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <Description>Stransfer Setup</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../dist/payload.zip" Condition="Exists('../../dist/payload.zip')" />
    <Resource Include="../Stransfer.App/Assets/app.png" Link="Assets/app.png" Condition="Exists('../Stransfer.App/Assets/app.png')" />
    <Resource Include="../Stransfer.App/Assets/app.ico" Link="Assets/app.ico" Condition="Exists('../Stransfer.App/Assets/app.ico')" />
  </ItemGroup>
</Project>
