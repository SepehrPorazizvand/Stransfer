<Application x:Class="Stransfer.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0D11"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#13161D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#252A36"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FE8E4C"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA46B"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E67935"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8E99A9"/>
  </Application.Resources>
</Application>
