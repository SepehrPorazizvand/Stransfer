<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Premium Dark Black & Orange Color Palette -->
  <Color x:Key="BackgroundColor">#0B0D11</Color>
  <Color x:Key="PanelColor">#13161D</Color>
  <Color x:Key="PanelHoverColor">#1B1E28</Color>
  <Color x:Key="PanelBorderColor">#252A36</Color>
  <Color x:Key="InputColor">#0E1016</Color>

  <!-- Brand Orange matching the logo -->
  <Color x:Key="AccentColor">#FE8E4C</Color>
  <Color x:Key="AccentHoverColor">#FFA46B</Color>
  <Color x:Key="AccentPressedColor">#E67935</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
  <SolidColorBrush x:Key="PanelHoverBrush" Color="{DynamicResource PanelHoverColor}"/>
  <SolidColorBrush x:Key="InputBrush" Color="{DynamicResource InputColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource PanelBorderColor}"/>
  <SolidColorBrush x:Key="BorderLightBrush" Color="#333948"/>

  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#261A13"/>
  <SolidColorBrush x:Key="AccentGlowBrush" Color="#3D2518"/>

  <SolidColorBrush x:Key="TextBrush" Color="#F3F5F9"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#8E99A9"/>
  <SolidColorBrush x:Key="DimBrush" Color="#586273"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>

  <!-- Speed Chart Gradient -->
  <LinearGradientBrush x:Key="SpeedChartFillBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#55FE8E4C" Offset="0"/>
    <GradientStop Color="#00FE8E4C" Offset="1"/>
  </LinearGradientBrush>

  <!-- Progress Bar Gradient -->
  <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FE8E4C" Offset="0"/>
    <GradientStop Color="#FFA76B" Offset="1"/>
  </LinearGradientBrush>

  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif</FontFamily>
  <Thickness x:Key="PagePadding">20</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
  <CornerRadius x:Key="ButtonRadius">6</CornerRadius>
</ResourceDictionary>
