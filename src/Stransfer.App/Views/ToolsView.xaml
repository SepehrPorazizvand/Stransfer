<UserControl x:Class="Stransfer.App.Views.ToolsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,0">
      <TextBlock Text="Tools and Runtime" Style="{StaticResource Heading}"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Transfer Engine • Included &amp; Self-Contained" Style="{StaticResource SubHeading}"/>
          <TextBlock Text="No external copy utilities or archive libraries are required. Transfers, verification, checkpoint journaling, resume, and Explorer integration run natively." Style="{StaticResource Hint}"/>
          <TextBlock Text="{Binding Runtime}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Optional developer and archive tools install using Windows Package Manager (winget) and accept repository agreements upon clicking install:" Style="{StaticResource Hint}" Margin="0,4,0,8"/>

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextBrush}"/>
                </DockPanel>
                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"/>
                <WrapPanel Margin="0,6,0,0">
                  <Button Content="Install via winget" Command="{Binding Install}" Style="{StaticResource Primary}"/>
                  <Button Content="Official website" Command="{Binding Website}"/>
                  <Button Content="Open documentation" Command="{Binding Open}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
